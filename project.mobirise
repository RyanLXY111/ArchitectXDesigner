    "index.html": {
      "settings": {
        "main": true,
        "title": "ARCHITECT × DESIGNER",
        "meta_descr": "Where Vision Shapes Function\nDesigners and architects share the same creative DNA\nblending art, logic, and empathy to build a world that looks good, feels right, and works better.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
